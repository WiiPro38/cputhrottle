[Desktop Entry]
Name=CPU Throttle
Name[ar]=التحكم في أداء المعالج
Comment=Control CPU performance and throttling on Linux
Comment[ar]=التحكم في أداء المعالج ومراقبة الحرارة والواط
Exec=/usr/bin/cputhrottle
Icon=cputhrottle
Terminal=false
Type=Application
StartupNotify=true
Categories=System;Settings;HardwareSettings;
Keywords=cpu;gpu;governor;turbo;frequency;performance;temperature;sensors;watt;power;
