def hex_to_rgb(h, default=(0.04, 0.52, 1.0)):
    m = re.fullmatch(r"#?([0-9a-fA-F]{6})", (h or "").strip())
    if not m:
        return default
    v = m.group(1)
    return tuple(int(v[i:i + 2], 16) / 255 for i in (0, 2, 4))


def rgb_to_hex(r, g, b):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(c * 255))) for c in (r, g, b))


def shade(h, factor):
    r, g, b = hex_to_rgb(h)
    return rgb_to_hex(r * factor, g * factor, b * factor)


def luminance(h):
    r, g, b = hex_to_rgb(h)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast_text(h):
    return "#000000" if luminance(h) > 0.6 else "#ffffff"


def make_palette(dark, accent):
    p = dict(PALETTES[bool(dark)])
    if not re.fullmatch(r"#[0-9a-fA-F]{6}", accent or ""):
