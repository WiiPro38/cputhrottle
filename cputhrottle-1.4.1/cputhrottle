CPU_CHIPS = {"coretemp", "k10temp", "zenpower", "cpu_thermal", "fam15h_power", "amd_energy"}
GPU_CHIPS = {"amdgpu": "AMD", "radeon": "AMD", "nouveau": "NVIDIA (nouveau)", "i915": "Intel", "xe": "Intel"}
STORAGE_CHIPS = {"nvme", "drivetemp"}
RAPL_LABELS = {
    "package-0": "CPU Package", "package-1": "CPU Package 2", "core": "CPU Cores",
    "uncore": "Integrated GPU / Uncore", "dram": "Memory (DRAM)", "psys": "Whole Platform (SoC + board)",
}


def _temp_inputs(hw):
    out = []
    for f in sorted(glob.glob(f"{hw}/temp*_input"), key=lambda p: int(re.sub(r"\D", "", os.path.basename(p)) or 0)):
        n = re.search(r"temp(\d+)_input", f).group(1)
        out.append({
            "path": f, "idx": int(n),
            "label": rd(f"{hw}/temp{n}_label") or f"temp{n}",
            "crit": rd_int(f"{hw}/temp{n}_crit"), "max": rd_int(f"{hw}/temp{n}_max"),
        })
    return out


def read_temp(path):
    v = rd_int(path)
    if v is None or v < -50_000 or v > 250_000:
        return None
    return v / 1000


def discover_hwmon():
    chips = []
    for hw in sorted(glob.glob(f"{HWMON}/hwmon*")):
        chips.append({"path": hw, "name": rd(f"{hw}/name", "") or "", "temps": _temp_inputs(hw)})
    return chips


def pick_cpu_package(chips):
    """Return the sensor dict best representing the CPU package temperature."""
    prefs = ("package id 0", "tdie", "tctl", "package", "cpu")
    for chip in chips:
        if chip["name"] not in CPU_CHIPS:
            continue
        for want in prefs:
            for t in chip["temps"]:
                if t["label"].lower().startswith(want):
                    return t
        if chip["temps"]:
            return chip["temps"][0]
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        if rd(f"{z}/type") in ("x86_pkg_temp", "cpu-thermal", "soc_thermal"):
            return {"path": f"{z}/temp", "idx": 0, "label": "CPU", "crit": None, "max": None}
    return None


def pci_name(device_dir):
    slot = None
    for line in (rd(f"{device_dir}/uevent", "") or "").splitlines():
        if line.startswith("PCI_SLOT_NAME="):
            slot = line.split("=", 1)[1]
    if slot and shutil.which("lspci"):
        try:
            out = subprocess.run(["lspci", "-s", slot, "-mm"], capture_output=True, text=True, timeout=3).stdout
            parts = re.findall(r'"([^"]*)"', out)
            if len(parts) >= 3:
                name = parts[2]
                m = re.search(r"\[([^\]]+)\]", name)
                return m.group(1) if m else name
        except (OSError, subprocess.SubprocessError):
            pass
    return None


def discover_gpus(chips):
    gpus = []
    for chip in chips:
        kind = GPU_CHIPS.get(chip["name"])
        if not kind:
            continue
        hw, dev = chip["path"], os.path.join(chip["path"], "device")
        power = next((f"{hw}/{n}" for n in ("power1_average", "power1_input") if os.path.exists(f"{hw}/{n}")), None)
        gpus.append({
            "name": pci_name(dev) or f"{kind} GPU", "kind": kind, "hw": hw,
            "temps": chip["temps"], "power": power,
            "energy": f"{hw}/energy1_input" if os.path.exists(f"{hw}/energy1_input") else None,
            "cap": f"{hw}/power1_cap" if os.path.exists(f"{hw}/power1_cap") else None,
            "util": f"{dev}/gpu_busy_percent" if os.path.exists(f"{dev}/gpu_busy_percent") else None,
            "clock": f"{hw}/freq1_input" if os.path.exists(f"{hw}/freq1_input") else None,
            "fan": next(iter(sorted(glob.glob(f"{hw}/fan*_input"))), None),
            "prev_energy": None,
        })
    return gpus


class NvidiaPoller:
    """Polls nvidia-smi in a background thread (it is slow, so never block the UI)."""
    QUERY = "name,temperature.gpu,power.draw,power.limit,utilization.gpu,clocks.gr,fan.speed"

    def __init__(self):
        self.exe = shutil.which("nvidia-smi")
        self.data = []
        self._stop = False
        if self.exe:
            threading.Thread(target=self._loop, daemon=True).start()

    @staticmethod
    def _num(s):
        try:
            return float(s)
        except (TypeError, ValueError):
            return None

    def _loop(self):
        while not self._stop:
            try:
                out = subprocess.run(
                    [self.exe, f"--query-gpu={self.QUERY}", "--format=csv,noheader,nounits"],
                    capture_output=True, text=True, timeout=5).stdout
                rows = []
                for line in out.strip().splitlines():
                    p = [x.strip() for x in line.split(",")]
                    if len(p) >= 7:
                        rows.append({"name": p[0], "temp": self._num(p[1]), "power": self._num(p[2]),
                                     "cap": self._num(p[3]), "util": self._num(p[4]),
                                     "clock": self._num(p[5]), "fan": self._num(p[6])})
                self.data = rows
            except (OSError, subprocess.SubprocessError):
                self.data = []
            time.sleep(2)


class PowerMeter:
    """CPU power from RAPL energy counters. On modern kernels energy_uj is root-only, so
    falls back to the numbers published by the optional cputhrottle-sampler service."""

    def __init__(self):
        self.domains = {}
        for path in sorted(glob.glob(f"{POWERCAP}/intel-rapl:[0-9]*")):
            name = rd(f"{path}/name")
            if name and name not in self.domains:
                self.domains[name] = path
        self.prev = {}
        self.source = "none"   # direct | sampler | none

    def poll(self):
        now = time.monotonic()
        out = {}
        for name, path in self.domains.items():
            e = rd_int(f"{path}/energy_uj")
            if e is None:
                continue
            wrap = rd_int(f"{path}/max_energy_range_uj") or 0
            p = self.prev.get(name)
            if p:
                de, dt = e - p[0], now - p[1]
                if de < 0 and wrap:
                    de += wrap
                if de >= 0 and dt > 0:
                    out[name] = de / dt / 1e6
            self.prev[name] = (e, now)
        if out:
            self.source = "direct"
            return out
        try:
            with open(SAMPLER_FILE) as f:
                d = json.load(f)
            if time.time() - float(d.get("ts", 0)) < 5:
                self.source = "sampler"
                return {k: float(v) for k, v in d.get("watts", {}).items()}
        except (OSError, ValueError, TypeError):
            pass
        if not any(rd_int(f"{p}/energy_uj") is not None for p in self.domains.values()):
            self.source = "none"
        return out


class SensorHub:
    def __init__(self):
        self.chips = discover_hwmon()
        self.cpu_pkg = pick_cpu_package(self.chips)
        self.core_temps = [t for c in self.chips if c["name"] in CPU_CHIPS
                           for t in c["temps"] if t["label"].lower().startswith("core")]
        self.gpus = discover_gpus(self.chips)
        self.nv = NvidiaPoller()
        self.meter = PowerMeter()
        used = {t["path"] for t in self.core_temps}
        if self.cpu_pkg:
            used.add(self.cpu_pkg["path"])
        for g in self.gpus:
            used.update(t["path"] for t in g["temps"])
        self.other_temps = []
        for c in self.chips:
            for t in c["temps"]:
                if t["path"] not in used and c["name"] not in GPU_CHIPS:
                    if c["name"] in CPU_CHIPS and t["label"].lower().startswith(("package", "tdie", "tctl")):
                        continue
                    self.other_temps.append(dict(t, chip=c["name"] or "hwmon"))
        self.fans = []
        for c in self.chips:
            for f in sorted(glob.glob(f"{c['path']}/fan*_input")):
                n = re.search(r"fan(\d+)_input", f).group(1)
                self.fans.append({"path": f, "label": f"{c['name']} {rd(c['path'] + '/fan' + n + '_label') or 'fan' + n}"})
        self.has_nvidia = bool(self.nv.exe)

    @property
    def has_gpu(self):
        return bool(self.gpus) or self.has_nvidia

    tjmax_override = None

    def crit_of_cpu(self):
        if self.tjmax_override:
            return float(self.tjmax_override)
        t = self.cpu_pkg
        if t:
            for key in ("crit", "max"):
                if t.get(key):
                    return t[key] / 1000
        return None

    def poll(self):
        snap = {"cpu_temp": read_temp(self.cpu_pkg["path"]) if self.cpu_pkg else None}
        snap["cores"] = {t["path"]: read_temp(t["path"]) for t in self.core_temps}
        snap["watts"] = self.meter.poll()
        snap["other"] = {t["path"]: read_temp(t["path"]) for t in self.other_temps}
        snap["fans"] = {f["path"]: rd_int(f["path"]) for f in self.fans}
        snap["batt_w"] = battery_watts()
        now = time.monotonic()
        gpus = []
        for g in self.gpus:
            d = {"name": g["name"], "kind": g["kind"], "temps": [(t["label"], read_temp(t["path"])) for t in g["temps"]]}
            d["temp"] = next((v for _, v in d["temps"] if v is not None), None)
            p = rd_int(g["power"]) if g["power"] else None
            d["power"] = p / 1e6 if p is not None else None
            if d["power"] is None and g["energy"]:
                e = rd_int(g["energy"])
                if e is not None and g["prev_energy"]:
                    de, dt = e - g["prev_energy"][0], now - g["prev_energy"][1]
                    if de >= 0 and dt > 0:
                        d["power"] = de / dt / 1e6
                if e is not None:
                    g["prev_energy"] = (e, now)
            cap = rd_int(g["cap"]) if g["cap"] else None
            d["cap"] = cap / 1e6 if cap else None
            d["util"] = rd_int(g["util"]) if g["util"] else None
            clk = rd_int(g["clock"]) if g["clock"] else None
            d["clock"] = clk / 1e6 if clk else None   # Hz → MHz
            d["fan"] = rd_int(g["fan"]) if g["fan"] else None
            d["fan_unit"] = "RPM"
            gpus.append(d)
        for d in self.nv.data:
            d = dict(d, kind="NVIDIA", temps=[("GPU", d["temp"])], fan_unit="%")
            gpus.append(d)
        snap["gpus"] = gpus
        # integrated GPU power on Intel clients is the RAPL "uncore" domain
        snap["igpu_w"] = snap["watts"].get("uncore")
        return snap


