    # ───────── Compare processors ─────────
    @staticmethod
    def match_words(typed, name):
        """True when every word typed appears somewhere in the name (any order, any case)."""
        low = name.lower()
        return all(w in low for w in (typed or "").lower().split())

    def make_search_combo(self, names, on_pick):
        """A drop-down whose own text box searches the list: type "5800", "i7 12", "ultra 9"…
        and pick from the suggestions. Each box searches independently of the others."""
        cb = Gtk.ComboBoxText.new_with_entry()
        cb.set_hexpand(True)
        for n in names:
            cb.append_text(n)
        entry = cb.get_child()
        entry.set_placeholder_text("Type to search…")
        comp = Gtk.EntryCompletion()
        comp.set_model(cb.get_model())
        comp.set_text_column(0)
        comp.set_minimum_key_length(1)
        comp.set_popup_completion(True)
        comp.set_inline_completion(False)
        comp.set_match_func(lambda _c, key, it, _d: self.match_words(key, comp.get_model()[it][0]), None)

        def picked(_c, model, it):
            cb.set_active(model.get_path(it).get_indices()[0])
            return True          # we already set the text; skip the default handler

        comp.connect("match-selected", picked)
        entry.set_completion(comp)
        entry.connect("focus-in-event", lambda w, _e: w.select_region(0, -1) or False)
        cb.connect("changed", lambda w: on_pick(w.get_active()))
        return cb

    def on_compare(self, _w):
        entries = self.unique_db()
        if len(entries) < 2:
            self.set_msg("The database needs at least two processors to compare.", True)
            return
        dlg = Gtk.Dialog(title="Compare processors", transient_for=self, modal=True)
        dlg.set_default_size(820, 700)
        dlg.add_button("Close", Gtk.ResponseType.CLOSE)
        area = dlg.get_content_area()
        area.set_spacing(8)
        area.set_border_width(10)

        names = [(r.get("name") or r["match"]) for r in entries]
        mine = self.cpu_entry
        start = []
        if mine is not None:
            start.append(entries.index(next(r for r in entries if tuple(r["_tokens"]) == tuple(mine["_tokens"]))))
        for i in range(len(entries)):
            if i not in start:
                start.append(i)
            if len(start) >= 3:
                break
        maps = [entries, entries, [None] + entries]                  # combo index -> entry (or None)
        state = {"cur": [entries[start[0]], entries[start[1]], None],
                 "busy": True}

        def render(*_):
            if state["busy"]:
                return
            for ch in grid.get_children():
                grid.remove(ch)
            cols = [c for c in state["cur"] if c is not None]
            grid.attach(Gtk.Label(label=""), 0, 0, 1, 1)
            for ci, c in enumerate(cols):
                h = Gtk.Label(label=c.get("name") or c["match"], xalign=0)
                h.set_line_wrap(True)
                h.get_style_context().add_class("teal-title")
                h.set_hexpand(True)
                grid.attach(h, ci + 1, 0, 1, 1)
            r = 1
            for label, key, fmt, best in self.ROWS:
                vals = [self.db_value(c, key) for c in cols]
                if all(x is None for x in vals):
                    continue
                grid.attach(self.dim(label), 0, r, 1, 1)
                win = set()
                nums = [x for x in vals if isinstance(x, (int, float))]
                if best and len(nums) >= 2 and max(nums) != min(nums):
                    target = max(nums) if best == "high" else min(nums)
                    win = {i for i, x in enumerate(vals) if x == target}
                for ci, x in enumerate(vals):
                    txt = "—" if x is None else (fmt.format(x) if fmt else str(x))
                    lbl = Gtk.Label(label=txt, xalign=0)
                    lbl.set_line_wrap(True)
                    if ci in win:
                        lbl.get_style_context().add_class("best")
                        lbl.set_text(txt + "  ▲")
                    grid.attach(lbl, ci + 1, r, 1, 1)
                r += 1
            note = self.dim("▲ = best value in that row (higher is better; for TDP the lowest). "
                            "Empty cells are not in the database yet — fill them in cpudb.csv.")
            note.set_line_wrap(True)
            grid.attach(note, 0, r, len(cols) + 1, 1)
            grid.show_all()

        def make_pick(col):
            def on_pick(idx):
                if state["busy"] or idx < 0:      # idx < 0 while the user is still typing
                    return
                state["cur"][col] = maps[col][idx]
                render()
            return on_pick

        top = Gtk.Grid(column_spacing=10, row_spacing=6)
        combos = []
        for col in range(3):
            cb = self.make_search_combo((["— none —"] if col == 2 else []) + names, make_pick(col))
            combos.append(cb)
            top.attach(cb, col, 0, 1, 1)
        area.pack_start(top, False, False, 0)

        sw = Gtk.ScrolledWindow()
        sw.set_vexpand(True)
        sw.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        grid = Gtk.Grid(column_spacing=18, row_spacing=6, border_width=8)
        sw.add(grid)
        area.pack_start(sw, True, True, 0)

        for col, cb in enumerate(combos):                 # initial choices
            cur = state["cur"][col]
            cb.set_active(maps[col].index(cur) if cur is not None else 0)
        state["busy"] = False
        render()
        dlg.show_all()
        dlg.run()
        dlg.destroy()

