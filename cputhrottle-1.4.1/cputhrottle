def declared_max_uw():
    """Maximum power each RAPL constraint declares (µW): {'long_term': x, 'short_term': y}."""
    out = {}
    for i in range(4):
        kind = rd(f"{RAPL}/constraint_{i}_name")
        mx = rd_int(f"{RAPL}/constraint_{i}_max_power_uw")
        if kind and mx:
            out[kind] = mx
    return out


def estimate_from_model(model, threads=0):
    """Rough (PL1, PL2) in watts from the CPU name. Only a last-resort fallback."""
    m = (model or "").upper()
    # Intel low-power N-series / Atom
    if re.search(r"\bN\d{3}\b", m) and "INTEL" in m:
        return 6, 25
    mm = re.search(r"ULTRA\s*[3579]\s*(\d{3})([A-Z]*)", m)
    if mm:
        suf = mm.group(2)
        if suf.endswith("HX"):
            return 55, 157
        if suf.endswith("V"):
            return 17, 37
        if suf.endswith("H"):
            return 28, 115
        if suf.endswith("U"):
            return 15, 57
        return 65, 121
    mm = re.search(r"I[3579]-(\d{4,5})([A-Z]{0,2}\d?)", m)
    if mm:
        num, suf = mm.group(1), mm.group(2)
        gen = int(num[:2]) if len(num) == 5 or num[0] == "1" else int(num[0])
        new = gen >= 12
        if suf.startswith("HX"):
            return 55, 157
        if suf.startswith("HK") or suf.startswith("HQ"):
            return 45, 65 if not new else 115
        if suf.startswith("H"):
            return (45, 115) if new else (45, 65)
        if suf.startswith("P"):
            return 28, 64
        if suf.startswith("U"):
            return (15, 55) if new else (15, 25)
        if suf.startswith("Y"):
            return 5, 9
        if re.match(r"G7", suf):
            return 28, 51
        if re.match(r"G\d", suf):
            return 15, 25
        if suf.startswith("T"):
            return 35, 70
        if re.match(r"K|X", suf):
            return 125, 190
        return 65, 90
    if "RYZEN" in m:
        if "RYZEN AI" in m:
            return 28, 54
        mm = re.search(r"RYZEN\s*[3579]\s*(\d{4})([A-Z0-9]*)", m)
        suf = mm.group(2) if mm else ""
        if suf.startswith("HX"):
            return 55, 90
        if suf.startswith("HS"):
            return 35, 45
        if suf.startswith("H"):
            return 45, 54
        if suf.startswith("U"):
            return 15, 25
        if "X3D" in suf:
            return 120, 162
        if suf.startswith("X"):
            return 105, 142
        if suf.startswith("GE"):
            return 35, 42
        return 65, 88
    return None


def _sane_w(uw):
    return uw is not None and 3_000_000 <= uw <= 400_000_000


def recommended_limits(model, original, declared, threads=0):
    """Return ({'pl1': µW, 'pl2': µW}, source_text) or (None, None).

    Order of trust: the firmware's own value captured on first launch (if it is
    consistent with the CPU's rated power) → the rated power the CPU declares
    through RAPL → an estimate from the model name.
    """
    est = estimate_from_model(model, threads)
    est_uw = (est[0] * 1_000_000, est[1] * 1_000_000) if est else None
    rated1 = declared.get("long_term")
    rated2 = declared.get("short_term")
    ref = rated1 if _sane_w(rated1) else (est_uw[0] if est_uw else None)

    o1 = int(original["pl1"]) if str(original.get("pl1", "")).isdigit() else None
    o2 = int(original["pl2"]) if str(original.get("pl2", "")).isdigit() else None
    if _sane_w(o1) and (ref is None or 0.4 * ref <= o1 <= 2.5 * ref):
        pl2 = o2 if _sane_w(o2) and o2 >= o1 else int(o1 * 1.25)
        return {"pl1": o1, "pl2": pl2}, "factory default for this machine"
    if _sane_w(rated1):
        pl2 = rated2 if _sane_w(rated2) and rated2 >= rated1 else int(rated1 * 1.25)
        return {"pl1": rated1, "pl2": pl2}, "rated power reported by the CPU"
    if est_uw:
        return {"pl1": est_uw[0], "pl2": est_uw[1]}, "estimated from CPU model"
    return None, None


