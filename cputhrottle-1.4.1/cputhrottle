    def unique_db(self):
        seen, out = set(), []
        for r in self.db:                      # user rows come first, so they win
            k = tuple(r["_tokens"])
            if k not in seen:
                seen.add(k)
                out.append(r)
        return sorted(out, key=lambda r: ((r.get("vendor") or ""), (r.get("name") or r["match"]).lower()))

