    def update_defaults(self, st):
        if not getattr(self, "dflt", None):
            return
        changed = 0
        for key, (cur, flag) in self.dflt.items():
            now = st.get(key)
            cur.set_text(self.show_setting(key, now))
            ctx_c, ctx_f = cur.get_style_context(), flag.get_style_context()
            if now is not None and not same_value(key, now, self.defaults[key]):
                changed += 1
                ctx_c.add_class("modified")
                ctx_f.add_class("modified")
                flag.set_text("✎ modified")
            else:
                ctx_c.remove_class("modified")
                ctx_f.remove_class("modified")
                flag.set_text("✔" if now is not None else "")
        if changed:
            self.lbl_dflt.set_text(f"{changed} setting{'s' if changed != 1 else ''} differ from the defaults.")
        else:
            self.lbl_dflt.set_text("All settings are at their defaults.")
        self.btn_restore.set_sensitive(changed > 0 and not self.busy)

