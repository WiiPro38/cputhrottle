def name_tokens(text):
    return re.findall(r"[a-z0-9]+", (text or "").lower())


def _num(v):
    try:
        return float(str(v).replace(",", "").strip())
    except ValueError:
        return None


def read_db_file(path):
    rows = []
    try:
        with open(path, encoding="utf-8-sig", newline="") as f:
            lines = [ln for ln in f if ln.strip() and not ln.lstrip().startswith("#")]
    except OSError:
        return rows
    for r in csv.DictReader(lines):
        r = {(k or "").strip(): (v or "").strip() for k, v in r.items()}
        if not r.get("match"):
            continue
        for k in DB_NUMERIC:
            r[k] = _num(r.get(k, ""))
        r["_tokens"] = name_tokens(r["match"])
        rows.append(r)
    return rows


def load_cpudb():
    """User rows first, so they win ties against the system database."""
    system = read_db_file(DB_SYSTEM) or read_db_file(DB_LOCAL)
    return read_db_file(DB_USER) + system


def lookup_cpu(model, rows):
    """Most specific row whose every `match` token is a whole word of the CPU name."""
    have = set(name_tokens(model))
    best, best_key = None, (0, 0)
    for r in rows:
        toks = r["_tokens"]
        if toks and all(t in have for t in toks):
            key = (len(toks), sum(len(t) for t in toks))
            if key > best_key:
                best, best_key = r, key
    return best


def model_match_key(model):
    """Short, stable key for a CPU name, e.g. 'i5-8365U' or 'Ryzen 7 5800H'."""
    m = re.search(r"(Ultra\s*[3579]\s*\d{3}[A-Z]*|i[3579]-\d{4,5}[A-Z0-9]*|Ryzen\s*(?:AI\s*)?[3579]\s*\w+|N\d{3}\b)", model or "", re.I)
    return re.sub(r"\s+", " ", m.group(1)).strip() if m else (model or "").strip()


def cpu_topology():
    cores = set()
    for i in all_cpu_ids():
        cid = rd(f"{CPU}/cpu{i}/topology/core_id")
        pkg = rd(f"{CPU}/cpu{i}/topology/physical_package_id", "0")
        if cid is not None:
            cores.add((pkg, cid))
    return (len(cores) or None), len(all_cpu_ids())


def append_user_db(row):
    try:
        os.makedirs(CONF_DIR, exist_ok=True)
