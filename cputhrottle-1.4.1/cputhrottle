            w.writerow({k: ("" if row.get(k) is None else row.get(k)) for k in DB_COLUMNS})
        return True
    except OSError:
        return False


def power_plan(model, original, declared, entry, threads=0):
    """Decide the recommended and maximum power limits (all in µW).

    Priority: CPU database → factory value (if plausible) → RAPL rating → estimate from name.
    The maximum for each spin box comes from the database when it knows the CPU, so the
    app never offers (or recommends) more than the CPU is rated for.
    """
    W = 1_000_000
    plan = {"rec": None, "source": None, "max1": 0, "max2": 0, "min1": 1 * W, "from_db": False}
    if entry and (entry.get("pl1_default_w") or entry.get("tdp_w")):
        p1 = entry.get("pl1_default_w") or entry["tdp_w"]
        p2 = entry.get("pl2_default_w") or p1
        mx1 = entry.get("pl1_max_w") or max(p1, entry.get("tdp_w") or 0)
        mx2 = entry.get("pl2_max_w") or max(p2, mx1)
        p2 = max(p2, p1)
        plan.update(rec={"pl1": int(p1 * W), "pl2": int(p2 * W)}, source="CPU database",
                    max1=int(max(mx1, p1) * W), max2=int(max(mx2, p2) * W), from_db=True)
        if entry.get("pl1_min_w"):
            plan["min1"] = int(entry["pl1_min_w"] * W)
        return plan
    rec, src = recommended_limits(model, original, declared, threads)
    plan["rec"], plan["source"] = rec, src
    tops = list(declared.values()) + [int(v) for v in original.values() if str(v).isdigit()]
    if rec:
        tops += list(rec.values())
    top = max(tops + [0])
    plan["max1"] = plan["max2"] = top
    return plan


