    def on_interval_changed(self, cb):
        self.conf["ui"]["interval"] = self.INTERVALS[max(cb.get_active(), 0)]
        save_conf(self.conf)
        self.start_timer()

    def on_tray_changed(self, *_):
        if self.filling:
            return
        tc = self.conf["tray"]
        tc["enabled"] = self.sw_tray.get_active()
        tc["mode"] = self.MODES[max(self.cb_mode.get_active(), 0)]
        tc["source"] = self.SOURCES[max(self.cb_source.get_active(), 0)]
        tc["warm_at"] = int(self.sp_warm.get_value())
        tc["hot_at"] = int(self.sp_hot.get_value())
