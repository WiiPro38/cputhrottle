            "pl2_default_w": round(int(f["pl2"]) / 1e6) if str(f.get("pl2", "")).isdigit() else "",
            "pl1_max_w": round(dec["long_term"] / 1e6) if dec.get("long_term") else "",
            "pl2_max_w": round(dec["short_term"] / 1e6) if dec.get("short_term") else "",
            "tjmax_c": round(self.hub.crit_of_cpu()) if self.hub.crit_of_cpu() else "",
            "status": "auto-detected - please verify",
