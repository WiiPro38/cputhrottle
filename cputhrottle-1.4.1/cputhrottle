    # ───────── Tray ─────────
    def tray_thresholds(self):
        tc = self.conf["tray"]
        crit = self.hub.crit_of_cpu()
        hot = tc["hot_at"] if tc.get("hot_at") is not None else (min(95, max(70, crit - 10)) if crit else 80)
        warm = tc["warm_at"] if tc.get("warm_at") is not None else hot - 15
        return int(warm), int(hot)

    def build_tray(self):
        base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
        self.tray_dir = os.path.join(base, f"cputhrottle-tray-{os.getuid()}")
        os.makedirs(self.tray_dir, exist_ok=True)
        for old in glob.glob(os.path.join(self.tray_dir, "*.png")):
            try:
                os.remove(old)
            except OSError:
                pass
        self.indicator = AppIndicator.Indicator.new_with_path(
            "cputhrottle", "utilities-system-monitor", AppIndicator.IndicatorCategory.HARDWARE, self.tray_dir)
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)

        menu = Gtk.Menu()
        for key, text in (("freq", "📊 Freq: —"), ("temp", "🌡 CPU: — (Max: —)"), ("gpu", "🎮 GPU: —"),
                          ("power", "⚡ Power: —"), ("turbo", "🚀 Turbo: —"), ("gov", "⚙ Governor: —")):
            item = Gtk.MenuItem(label=text)
            item.set_sensitive(False)
            self.tray_items[key] = item
            menu.append(item)
        menu.append(Gtk.SeparatorMenuItem())
        for text, name in (("🔋 Power Saver", PRESETS[0]), ("⚖ Balanced", PRESETS[1]), ("🚀 Performance", PRESETS[2])):
            item = Gtk.MenuItem(label=text)
            item.connect("activate", lambda _, n=name: self.apply_profile(n))
            menu.append(item)
        menu.append(Gtk.SeparatorMenuItem())
        show_item = Gtk.MenuItem(label="🖥 Show Interface")
        show_item.connect("activate", lambda *_: self.present())
        menu.append(show_item)
        exit_item = Gtk.MenuItem(label="❌ Exit")
        exit_item.connect("activate", lambda *_: Gtk.main_quit())
        menu.append(exit_item)
        menu.show_all()
        self.indicator.set_menu(menu)

    def tray_temp(self, snap):
        cpu = snap["cpu_temp"]
        gpu = next((g["temp"] for g in snap["gpus"] if g.get("temp") is not None), None)
        src = self.conf["tray"]["source"]
        if src == "gpu":
            return gpu if gpu is not None else cpu
        if src == "max":
            vals = [v for v in (cpu, gpu) if v is not None]
            return max(vals) if vals else None
        return cpu

    def update_tray(self, snap):
        if self.indicator is None:
            return
        tc = self.conf["tray"]
        t = self.tray_temp(snap)
        if not tc["enabled"] or t is None:
            if self.tray_key != ("off",):
                self.indicator.set_icon_full("utilities-system-monitor", APP_NAME)
                self.indicator.set_label("", "")
                self.tray_key = ("off",)
            return
        warm, hot = self.tray_thresholds()
        color = tc["hot"] if t >= hot else tc["warm"] if t >= warm else tc["cool"]
        num = round(to_unit(t, self.unit))
        mode = tc["mode"]
        if mode in ("badge", "both") and pycairo is None:
            mode = "text"
        key = (mode, num, color, self.unit)
        if key == self.tray_key:
            return
        self.tray_key = key
        shown = False
        if mode in ("badge", "both"):
            self.tray_flip ^= 1   # alternate the icon name so the panel reloads the image
            name = f"cputhrottle-temp-{self.tray_flip}"
            shown = render_tray_badge(os.path.join(self.tray_dir, name + ".png"), str(num), color)
            if shown:
                self.indicator.set_icon_full(name, f"{num}°{self.unit}")
        if not shown:
            self.indicator.set_icon_full("utilities-system-monitor", APP_NAME)
        if mode in ("text", "both"):
            self.indicator.set_label(f" {num}°{self.unit}", "000°F")
        else:
            self.indicator.set_label("", "")

    def on_close(self, *_):
        if self.indicator is not None and self.conf["tray"]["enabled"]:
            self.hide()
            return True
        return False

    # ───────── Refresh ─────────
    def refresh(self):
        freqs = []
        for cid, bar, val in self.bars:
            khz = rd(f"{CPU}/cpu{cid}/cpufreq/scaling_cur_freq")
            if khz and khz.isdigit():
                mhz = int(khz) // 1000
                freqs.append(mhz)
                bar.set_value(mhz)
                val.set_text(str(mhz))
            else:
                bar.set_value(0)
                val.set_text("—")

        st = read_state()
        snap = self.hub.poll()
        t = snap["cpu_temp"]
        if t is not None and t > self.max_temp_recorded:
            self.max_temp_recorded = t

        b_percent, b_status = battery_info()
        if b_percent is not None:
            self.batt_widget.update(b_percent, b_status)
            desc = {"Charging": "Charging ⚡", "Full": "Plugged In / Fully Charged ⚡"}.get(b_status, "Discharging / On Battery")
            self.lbl_batt_status.set_markup(f"<b>Status:</b> {desc} | <b>Level:</b> {b_percent}%")
        else:
            self.batt_widget.update(100, "Full")
            self.lbl_batt_status.set_markup("<b>Status:</b> Desktop connected to AC power")

        turbo = st.get("turbo")
        pl1, pl2 = st.get("pl1"), st.get("pl2")
        avg_freq = sum(freqs) // len(freqs) if freqs else 0
        watts = self.pkg_watts(snap)
        power_str = f"{watts:.1f} W" if watts is not None else "—"
        gpu0 = snap["gpus"][0] if snap["gpus"] else {}

        self.info["freq"].set_text(f"{avg_freq} MHz" if freqs else "—")
        self.info["temp"].set_text(self.ft(t))
        self.info["maxtemp"].set_text(self.ft(self.max_temp_recorded) if self.max_temp_recorded > 0 else "—")
        if "gpu" in self.info:
            gt, gp = gpu0.get("temp"), gpu0.get("power")
            self.info["gpu"].set_text(f"{self.ft(gt, 0)} · {gp:.0f} W" if gt is not None and gp is not None
                                      else self.ft(gt, 0) if gt is not None else "—")
        self.info["gov"].set_text(st.get("governor", "—"))
        self.info["profile"].set_text(st.get("profile", "—"))
        self.info["turbo"].set_text({"on": "Enabled", "off": "Disabled"}.get(turbo, "—"))
        self.info["limits"].set_text(f"{int(pl1) / 1e6:.0f}W / {int(pl2) / 1e6:.0f}W" if pl1 and pl2 else "—")
        self.info["cores"].set_text(f"{st.get('cores', '—')} / {len(self.ids)}")
        self.info["power"].set_text(power_str)

        if self.tray_items:
            self.tray_items["freq"].set_label(f"📊 Freq: {avg_freq} MHz")
            mx = self.ft(self.max_temp_recorded) if self.max_temp_recorded > 0 else "—"
            self.tray_items["temp"].set_label(f"🌡 CPU: {self.ft(t)} (Max: {mx})")
            gt = gpu0.get("temp")
            gp = gpu0.get("power")
            self.tray_items["gpu"].set_label("🎮 GPU: " + (self.ft(gt, 0) if gt is not None else "—")
                                             + (f" · {gp:.0f} W" if gp is not None else ""))
            self.tray_items["power"].set_label(f"⚡ Power: {power_str}")
            self.tray_items["turbo"].set_label("🚀 Turbo Boost: " + ("Enabled" if turbo == "on" else "Disabled"))
            self.tray_items["gov"].set_label(f"⚙ Governor: {st.get('governor', '—')}")

        self.update_defaults(st)
        self.update_sensors(snap)
        self.update_tray(snap)
        self.check_auto(power_source())
        return True

    def load_controls(self):
        st = read_state()
        if "governor" in st:
            set_combo(self.cb_gov, self.governors, st["governor"])
        if "epp" in st:
            set_combo(self.cb_epp, self.epps, st["epp"])
        if "profile" in st:
            set_combo(self.cb_prof, self.profiles, st["profile"])
        if "min" in st:
            self.sc_min.set_value(int(st["min"]) // 1000)
        if "max" in st:
            self.sc_max.set_value(int(st["max"]) // 1000)
        if "turbo" in st:
            self.sw_turbo.set_active(st["turbo"] == "on")
        if "pl1" in st:
            self.sp_pl1.set_value(round(int(st["pl1"]) / 1e6))
        if "pl2" in st:
            self.sp_pl2.set_value(round(int(st["pl2"]) / 1e6))
        if "cores" in st:
            self.sp_cores.set_value(int(st["cores"]))
        if "smt" in st:
            self.sw_smt.set_active(st["smt"] == "on")
        self.pl_loaded = (self.sp_pl1.get_value(), self.sp_pl2.get_value())
        self.check_over_limit(st)

    def check_over_limit(self, st):
        pal = CURRENT["pal"]
        msgs = []
        if self.plan["from_db"]:
            for key, mx, name in (("pl1", self.plan["max1"], "PL1"), ("pl2", self.plan["max2"], "PL2")):
                if key in st and mx and int(st[key]) > mx * 1.02:
                    msgs.append(f"{name} is {int(st[key]) / 1e6:.0f} W, above this CPU's rated maximum of {mx / 1e6:.0f} W")
        if msgs:
            self.lbl_over.set_markup(f'<span foreground="{pal["bad"]}">⚠ ' + GLib.markup_escape_text("; ".join(msgs)
                                     + ". Use “Use recommended”, then Save & Apply.") + "</span>")
        else:
            self.lbl_over.set_text("")

    def set_msg(self, text, error=False):
        pal = CURRENT["pal"]
        color = pal["bad"] if error else pal["ok"]
        self.lbl_msg.set_markup(f'<span foreground="{color}">{GLib.markup_escape_text(text)}</span>')

    def collect(self, full=False):
        d = {}
        s = self.supported
        if "governor" in s and self.cb_gov.get_active_text():
            d["governor"] = self.cb_gov.get_active_text()
        if "epp" in s and self.cb_epp.get_active_text():
            d["epp"] = self.cb_epp.get_active_text()
        if "profile" in s and self.cb_prof.get_active_text():
            d["profile"] = self.cb_prof.get_active_text()
        if "min" in s:
            d["min"] = str(int(self.sc_min.get_value()) * 1000)
        if "max" in s:
            d["max"] = str(int(self.sc_max.get_value()) * 1000)
        if "turbo" in s:
            d["turbo"] = "on" if self.sw_turbo.get_active() else "off"
        if "cores" in s:
            d["cores"] = str(int(self.sp_cores.get_value()))
        if "smt" in s:
            d["smt"] = "on" if self.sw_smt.get_active() else "off"
        loaded = getattr(self, "pl_loaded", (None, None))
        if "pl1" in s and (full or self.sp_pl1.get_value() != loaded[0]):
            d["pl1"] = str(int(self.sp_pl1.get_value()) * 1_000_000)
        if "pl2" in s and (full or self.sp_pl2.get_value() != loaded[1]):
            d["pl2"] = str(int(self.sp_pl2.get_value()) * 1_000_000)
        return d

    def on_apply(self, _w):
        args = self.collect(full=True)
        if "min" in args and "max" in args and int(args["min"]) > int(args["max"]):
            self.set_msg("✘ Minimum frequency cannot exceed maximum frequency.", True)
            return
        if "pl1" in args and "pl2" in args and int(args["pl2"]) < int(args["pl1"]):
            self.set_msg("✘ Short PL2 limit cannot be less than PL1.", True)
            return
        self.run_helper(args)

    def preset_limits(self, name):
        """PL1/PL2 (µW) for a preset, scaled from this CPU's recommended values."""
        if not self.rec or "pl1" not in self.supported:
            return {}
        r1, r2 = self.rec["pl1"], self.rec["pl2"]
        cap1 = self.up1 * 1_000_000 if self.up1 else r1
        cap2 = self.up2 * 1_000_000 if self.up2 else r2
        if name == PRESETS[0]:
            p1, p2 = max(self.plan["min1"], int(r1 * 0.6)), r1
        else:
            p1, p2 = r1, r2
        p1 = min(p1, cap1)
        p2 = min(max(p2, p1), max(cap2, p1))
        return {"pl1": str(round(p1 / 1e6) * 1_000_000), "pl2": str(round(p2 / 1e6) * 1_000_000)}

    def preset_args(self, name):
        if name == PRESETS[0]:
            g = pick(self.governors, ["powersave", "conservative"])
            e = pick(self.epps, ["power", "balance_power"])
            p = pick(self.profiles, ["low-power", "quiet", "cool"])
            a = {"turbo": "off", "min": str(self.fmin * 1000),
                 "max": str(int(self.fmax * 0.6) // 100 * 100 * 1000)}
        elif name == PRESETS[1]:
            g = pick(self.governors, ["schedutil", "ondemand", "powersave"])
            e = pick(self.epps, ["balance_performance", "default"])
            p = pick(self.profiles, ["balanced"])
            a = {"turbo": "on", "min": str(self.fmin * 1000), "max": str(self.fmax * 1000)}
        else:
            g = pick(self.governors, ["performance"])
            e = pick(self.epps, ["performance"])
            p = pick(self.profiles, ["performance", "balanced-performance"])
            a = {"turbo": "on", "min": str(self.fmin * 1000), "max": str(self.fmax * 1000)}
        for k, v in (("governor", g), ("epp", e), ("profile", p)):
            if v:
                a[k] = v
        a.update(self.preset_limits(name))
        return a

    def args_for(self, name):
        if name in PRESETS:
            return self.preset_args(name)
        return dict(self.conf["profiles"].get(name, {}))

    def apply_profile(self, name):
        args = self.args_for(name)
        if not args:
            self.set_msg(f"✘ Profile «{name}» does not exist.", True)
            return
        self.run_helper(args, label=name)

    def run_helper(self, args, label=None):
        if self.busy:
            return
        if not os.path.exists(HELPER):
            self.set_msg(f"Helper binary not found: {HELPER}", True)
            return
        self.busy = True
        self.btn_apply.set_sensitive(False)
        self.set_msg("Waiting for privileges authorization...")
        cmd = ["pkexec", HELPER, "apply"] + [f"{k}={v}" for k, v in args.items()]

        def worker():
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
                GLib.idle_add(self.done, r.returncode, (r.stderr or r.stdout).strip(), label)
            except FileNotFoundError:
                GLib.idle_add(self.done, 127, "The pkexec command is not available.", label)
            except subprocess.TimeoutExpired:
                GLib.idle_add(self.done, 124, "Operation timed out.", label)

        threading.Thread(target=worker, daemon=True).start()

    def done(self, code, out, label):
        self.busy = False
        self.btn_apply.set_sensitive(True)
        if code == 0:
            self.set_msg("✔ Successfully applied " + (f"«{label}»" if label else "settings"))
        elif code in (126, 127) and not out:
            self.set_msg("Privileges request cancelled.", True)
        else:
            self.set_msg(f"✘ Failed to apply:\n{out or code}", True)
        self.load_controls()
        self.refresh()
        return False

    def on_saved_apply(self, _w):
        name = self.cb_saved.get_active_text()
        if name:
            self.apply_profile(name)
        else:
            self.set_msg("Please select a profile first.", True)

    def on_saved_save(self, _w):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.OK_CANCEL, text="New Profile Name")
        entry = Gtk.Entry()
        entry.set_activates_default(True)
        dlg.get_content_area().pack_start(entry, False, False, 6)
        dlg.set_default_response(Gtk.ResponseType.OK)
        dlg.show_all()
        resp = dlg.run()
        name = entry.get_text().strip()
        dlg.destroy()
        if resp != Gtk.ResponseType.OK or not name:
            return
        if name in PRESETS:
            self.set_msg("✘ This name is reserved.", True)
            return
        self.conf["profiles"][name] = self.collect(full=True)
        ok = save_conf(self.conf)
        self.sync_boot()
        self.fill_profile_lists(select=name)
        self.set_msg(f"✔ Successfully saved «{name}»" if ok else "✘ Failed to save", not ok)

    def on_saved_delete(self, _w):
        name = self.cb_saved.get_active_text()
        if not name:
            return
        self.conf["profiles"].pop(name, None)
        save_conf(self.conf)
        self.fill_profile_lists()
        self.sync_boot()
        self.set_msg(f"Deleted profile «{name}»")

    def on_auto_toggled_bottom(self, widget):
        if self.filling:
            return
        self.conf["auto"]["enabled"] = widget.get_active()
        save_conf(self.conf)
        self.sync_boot()
        self.applied_source = "unset"

    def on_startup_toggled(self, widget):
        try:
            if widget.get_active():
                os.makedirs(AUTOSTART_DIR, exist_ok=True)
                with open(AUTOSTART_FILE, "w", encoding="utf-8") as f:
                    f.write("[Desktop Entry]\nType=Application\nName=CPU Throttle\n"
                            "Exec=/usr/bin/cputhrottle\nIcon=utilities-system-monitor\n"
                            "Terminal=false\nX-GNOME-Autostart-enabled=true\n")
                self.set_msg("✔ Enabled run at startup.")
            else:
                if os.path.exists(AUTOSTART_FILE):
                    os.remove(AUTOSTART_FILE)
                self.set_msg("✔ Disabled run at startup.")
        except OSError as e:
            self.set_msg(f"✘ Failed to change startup state: {e}", True)

    def on_auto_changed(self, *_):
        if self.filling:
            return
        ac, bat = self.cb_auto_ac.get_active_text(), self.cb_auto_bat.get_active_text()
        if ac:
            self.conf["auto"]["ac"] = ac
        if bat:
            self.conf["auto"]["battery"] = bat
        save_conf(self.conf)
        self.sync_boot()
        self.applied_source = "unset"

    def check_auto(self, src):
        if not self.conf["auto"]["enabled"] or src is None or self.busy:
            return
        if src == self.applied_source:
            return
        self.applied_source = src
        name = self.conf["auto"]["ac" if src else "battery"]
        if name in self.profile_names():
            self.apply_profile(name)


