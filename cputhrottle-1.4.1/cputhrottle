def rounded_rect(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def fg_rgb():
    return (1, 1, 1) if CURRENT["dark"] else (0.1, 0.1, 0.12)


class BatteryWidget(Gtk.DrawingArea):
    def __init__(self):
        super().__init__()
        self.set_size_request(100, 32)
        self.percentage = 100
        self.status = "Discharging"

    def update(self, percentage, status):
        self.percentage = percentage if percentage is not None else 100
        self.status = status
        self.queue_draw()

    def do_draw(self, cr):
        bx, by, bw, bh = 4, 4, 68, 24
        fr, fg, fb = fg_rgb()
        cr.set_line_width(1.5)
        rounded_rect(cr, bx, by, bw, bh, 4)
        cr.set_source_rgba(fr, fg, fb, 0.12)
        cr.fill_preserve()
        cr.set_source_rgba(fr, fg, fb, 0.35)
        cr.stroke()

        cr.rectangle(bx + bw, by + 8, 3, 8)
        cr.set_source_rgba(fr, fg, fb, 0.35)
        cr.fill()

        fill_width = (bw - 6) * (max(0, min(100, self.percentage)) / 100.0)
        if fill_width > 0:
            rounded_rect(cr, bx + 3, by + 3, fill_width, bh - 6, 2)
            if self.status in ("Charging", "Full"):
                cr.set_source_rgb(0.18, 0.8, 0.35)
            elif self.percentage < 20:
                cr.set_source_rgb(1.0, 0.27, 0.23)
            else:
                r, g, b = hex_to_rgb(CURRENT["pal"]["accent"])
                cr.set_source_rgb(r, g, b)
            cr.fill()

        icon_x, icon_y = bx + bw + 10, by + 12
        if self.status in ("Charging", "Full"):
            cr.set_source_rgb(1.0, 0.8, 0.0)
            cr.move_to(icon_x + 2, icon_y - 5)
            cr.line_to(icon_x - 2, icon_y + 1)
            cr.line_to(icon_x + 2, icon_y + 1)
            cr.line_to(icon_x - 1, icon_y + 6)
            cr.line_to(icon_x + 5, icon_y)
            cr.line_to(icon_x + 1, icon_y)
            cr.close_path()
            cr.fill()

        cr.set_source_rgb(fr, fg, fb)
        cr.select_font_face("Sans", 0, 1)   # normal slant, bold
        cr.set_font_size(11)
        text = f"{self.percentage}%"
        ext = cr.text_extents(text)
        cr.move_to(bx + (bw - ext.width) / 2 - ext.x_bearing, by + (bh + ext.height) / 2)
        cr.show_text(text)
        return False


class Sparkline(Gtk.DrawingArea):
    """Small live graph of the last N samples."""

    def __init__(self, title, unit, fmt="{:.1f}", size=120):
        super().__init__()
        self.title, self.unit, self.fmt = title, unit, fmt
        self.values = collections.deque(maxlen=size)
        self.set_size_request(220, 78)
        self.set_hexpand(True)

    def push(self, v):
        self.values.append(v)
        self.queue_draw()

    def do_draw(self, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        fr, fg, fb = fg_rgb()
        ar, ag, ab = hex_to_rgb(CURRENT["pal"]["accent"])
        rounded_rect(cr, 0.5, 0.5, w - 1, h - 1, 8)
        cr.set_source_rgba(fr, fg, fb, 0.05)
        cr.fill_preserve()
        cr.set_source_rgba(fr, fg, fb, 0.12)
        cr.set_line_width(1)
        cr.stroke()

        vals = [v for v in self.values if v is not None]
        cr.select_font_face("Sans", 0, 0)
        cr.set_font_size(11)
        cr.set_source_rgba(fr, fg, fb, 0.6)
        cr.move_to(10, 16)
        cr.show_text(self.title)

        if not vals:
            cr.move_to(10, h / 2 + 8)
            cr.show_text("—")
            return False

        cur = self.values[-1]
        cr.select_font_face("Sans", 0, 1)
        cr.set_font_size(15)
        cr.set_source_rgb(fr, fg, fb)
        label = (self.fmt.format(cur) + " " + self.unit) if cur is not None else "—"
        ext = cr.text_extents(label)
        cr.move_to(w - ext.width - 10, 17)
        cr.show_text(label)

        lo, hi = min(vals), max(vals)
        if hi - lo < 1e-6:
            lo, hi = lo - 1, hi + 1
        pad = (hi - lo) * 0.15
        lo, hi = lo - pad, hi + pad
        top, bot, left, right = 26, h - 8, 10, w - 10
        n = self.values.maxlen
        step = (right - left) / max(n - 1, 1)
        pts = []
        off = n - len(self.values)
        for i, v in enumerate(self.values):
            if v is None:
                continue
            pts.append((left + (off + i) * step, bot - (v - lo) / (hi - lo) * (bot - top)))
        if len(pts) >= 2:
            cr.move_to(*pts[0])
            for p in pts[1:]:
                cr.line_to(*p)
            cr.set_source_rgb(ar, ag, ab)
            cr.set_line_width(1.8)
            cr.stroke_preserve()
            cr.line_to(pts[-1][0], bot)
            cr.line_to(pts[0][0], bot)
            cr.close_path()
            cr.set_source_rgba(ar, ag, ab, 0.18)
            cr.fill()
        return False


def render_tray_badge(path, text, color_hex):
    """Write a 64×64 PNG: a coloured rounded badge with the temperature inside."""
    if pycairo is None:
        return False
    size = 64
    surf = pycairo.ImageSurface(pycairo.FORMAT_ARGB32, size, size)
    cr = pycairo.Context(surf)
    r, g, b = hex_to_rgb(color_hex)
    rounded_rect(cr, 2, 2, size - 4, size - 4, 16)
    cr.set_source_rgb(r, g, b)
    cr.fill()
    tr, tg, tb = hex_to_rgb(contrast_text(color_hex))
    cr.set_source_rgb(tr, tg, tb)
    cr.select_font_face("Sans", 0, 1)
    cr.set_font_size(38 if len(text) <= 2 else 28)
    ext = cr.text_extents(text)
    cr.move_to(size / 2 - ext.width / 2 - ext.x_bearing, size / 2 - ext.height / 2 - ext.y_bearing)
    cr.show_text(text)
    surf.write_to_png(path)
    return True


