    def sync_boot(self):
        """Store the resolved settings the boot service must apply, so it needs no knowledge of
        presets, users or home directories at boot."""
        auto = self.conf["auto"]
        boot = {"enabled": bool(auto["enabled"]),
                "ac": self.args_for(auto["ac"]) if auto["ac"] in self.profile_names() else {},
                "battery": self.args_for(auto["battery"]) if auto["battery"] in self.profile_names() else {}}
        if self.conf.get("boot") != boot:
            self.conf["boot"] = boot
            save_conf(self.conf)

