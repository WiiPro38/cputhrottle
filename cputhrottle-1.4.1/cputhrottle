        model = cpu_model()
        cores, threads = cpu_topology()
        f = self.factory
        dec = self.declared
        base = rd_int(f"{CPU}/cpu0/cpufreq/base_frequency")
        row = {
            "match": model_match_key(model),
            "vendor": "Intel" if "intel" in model.lower() else "AMD" if "amd" in model.lower() else "",
            "name": re.sub(r"\s+", " ", model),
            "cores": cores, "threads": threads,
