        save_conf(self.conf)
        self.tray_key = None
        self.refresh()

    def on_tray_reset(self, _w):
        self.filling = True
        tc = self.conf["tray"]
        tc.update({k: DEFAULT_TRAY[k] for k in ("cool", "warm", "hot", "warm_at", "hot_at")})
        for btn, key in ((self.btn_cool, "cool"), (self.btn_warm, "warm"), (self.btn_hot, "hot")):
