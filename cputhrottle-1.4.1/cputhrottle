    # ───────── Defaults vs current ─────────
    def default_state(self):
        """What each setting is at stock: PL limits from the CPU database/factory value, frequency
        range and turbo/cores/SMT from the hardware, governor/EPP/profile from the kernel's usual defaults."""
        d, s = {}, self.supported
        if "pl1" in s and self.rec:
            d["pl1"], d["pl2"] = str(self.rec["pl1"]), str(self.rec["pl2"])
        if "min" in s and self.fmin:
            d["min"] = str(self.fmin * 1000)
        if "max" in s and self.fmax:
            d["max"] = str(self.fmax * 1000)
        if "turbo" in s:
            d["turbo"] = "on"
        if "cores" in s:
            d["cores"] = str(len(self.ids))
        if "smt" in s:
            d["smt"] = "on"
        if "governor" in s:
            drv = rd(f"{CPU}/cpu0/cpufreq/scaling_driver", "") or ""
            g = pick(self.governors, ["powersave"]) if drv.startswith(("intel_pstate", "amd-pstate")) \
                else pick(self.governors, ["schedutil", "ondemand", "powersave"])
            if g:
                d["governor"] = g
        if "epp" in s:
            e = pick(self.epps, ["balance_performance", "default"])
            if e:
                d["epp"] = e
        if "profile" in s:
            p = pick(self.profiles, ["balanced"])
            if p:
                d["profile"] = p
        return d

    @staticmethod
    def show_setting(key, v):
        if v is None:
            return "—"
        if key in ("pl1", "pl2"):
            return f"{int(v) / 1e6:.0f} W"
        if key in ("min", "max"):
            return f"{int(v) // 1000} MHz"
        if key in ("turbo", "smt"):
            return {"on": "On", "off": "Off"}.get(v, v)
        return str(v)

