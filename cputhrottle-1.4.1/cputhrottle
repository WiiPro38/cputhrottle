# ───────────────────────── System helpers ─────────────────────────
def rd(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def rd_int(path):
    v = rd(path)
    if v is None:
        return None
    try:
        return int(v)
    except ValueError:
        return None


def all_cpu_ids():
    ids = []
    for p in glob.glob(f"{CPU}/cpu[0-9]*"):
        name = os.path.basename(p)[3:]
        if name.isdigit():
            ids.append(int(name))
    return sorted(ids)


def online_ids():
    return [i for i in all_cpu_ids() if i == 0 or rd(f"{CPU}/cpu{i}/online", "1") == "1"]


def cpu_model():
    for line in (rd("/proc/cpuinfo", "") or "").splitlines():
        if line.startswith("model name"):
            return line.split(":", 1)[1].strip()
    return "CPU"


def system_batteries():
    """The computer's own batteries (peripheral batteries such as wireless mice are skipped)."""
    out = []
    for ps in sorted(glob.glob(f"{POWER_SUPPLY}/*")):
        if rd(f"{ps}/type") == "Battery" and rd(f"{ps}/scope", "System") != "Device":
            out.append(ps)
    return out


def battery_info():
    caps, statuses = [], []
    for ps in system_batteries():
        cap = rd(f"{ps}/capacity")
        if cap and cap.isdigit():
            caps.append(int(cap))
            statuses.append(rd(f"{ps}/status") or rd(f"{ps}/state", "Discharging"))
    if not caps:
        return None, "Unknown"
    for st in ("Charging", "Discharging", "Full"):
        if st in statuses:
            return round(sum(caps) / len(caps)), st
    return round(sum(caps) / len(caps)), statuses[0]


def _sane_batt_watts(w):
    """Laptop battery power is between ~0.1 and 300 W. A few drivers report mW/mA instead of
    µW/µA, so try ×1000 / ÷1000 before giving up."""
    for scale in (1, 1000, 0.001):
        x = w * scale
        if 0.1 <= x <= 300:
            return x
    return None


def battery_watts():
    """Instant battery power in watts, summed over the system batteries (None if unknown).
    sysfs units: power_now = µW; current_now = µA and voltage_now = µV, so µA·µV/1e6 = µW."""
    total, found = 0.0, False
    for ps in system_batteries():
        p = rd_int(f"{ps}/power_now")
        if not p:
            i, v = rd_int(f"{ps}/current_now"), rd_int(f"{ps}/voltage_now")
            p = abs(i) * v / 1e6 if i and v else None
        if not p:
            continue
        w = _sane_batt_watts(abs(p) / 1e6)
        if w is not None:
            total += w
            found = True
    return total if found else None


def turbo_state():
    v = rd(f"{CPU}/intel_pstate/no_turbo")
    if v is not None:
        return v == "0"
    v = rd(f"{CPU}/cpufreq/boost")
    if v is not None:
        return v == "1"
    return None


def avail(path):
    return (rd(path, "") or "").split()


def pick(options, wanted):
    for w in wanted:
        if w in options:
            return w
    return None


def rapl_index(kind):
    for i in range(4):
        if rd(f"{RAPL}/constraint_{i}_name") == kind:
            return i
    return None


def power_source():
    has_batt = False
    ac_online = None
    batts = system_batteries()
    for ps in sorted(glob.glob(f"{POWER_SUPPLY}/*")):
        ptype = rd(f"{ps}/type")
        if ptype == "Battery":
            if ps not in batts:
                continue
            has_batt = True
            if rd(f"{ps}/status") in ("Charging", "Full"):
                return True
        elif ptype in ("Mains", "USB"):
            online = rd(f"{ps}/online")
            if online == "1":
                ac_online = True
            elif online == "0" and ac_online is None:
                ac_online = False
    if ac_online is not None:
        return ac_online
    if not has_batt:
        return None
    _, status = battery_info()
    return status != "Discharging"


def read_state():
    s = {}
    base = f"{CPU}/cpu0/cpufreq"
    v = rd(f"{base}/scaling_governor")
    if v:
        s["governor"] = v
    v = rd(f"{base}/energy_performance_preference")
    if v:
        s["epp"] = v
    for k, f in (("min", "scaling_min_freq"), ("max", "scaling_max_freq")):
        v = rd(f"{base}/{f}")
        if v and v.isdigit():
            s[k] = v
    t = turbo_state()
    if t is not None:
        s["turbo"] = "on" if t else "off"
    for k, kind in (("pl1", "long_term"), ("pl2", "short_term")):
        i = rapl_index(kind)
        if i is not None:
            v = rd(f"{RAPL}/constraint_{i}_power_limit_uw")
            if v and v.isdigit():
                s[k] = v
    v = rd(PLATFORM)
    if v:
        s["profile"] = v
    if rd(f"{CPU}/smt/control") in ("on", "off"):
        s["smt"] = rd(f"{CPU}/smt/control")
    if len(all_cpu_ids()) > 1:
        s["cores"] = str(len(online_ids()))
    return s


def same_value(key, a, b):
    tol = TOLERANCE.get(key)
    if tol is not None:
        try:
            return abs(int(a) - int(b)) < tol
        except ValueError:
            return False
    return a == b


