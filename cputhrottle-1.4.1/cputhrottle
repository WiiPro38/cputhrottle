    def set_temp_row(self, key, v):
        lbl = self.sv.get(key)
        if lbl is None:
            return
        if v is None:
            lbl.set_text("—")
            return
        mx = max(self.tmax.get(key, v), v)
        self.tmax[key] = mx
        lbl.set_text(f"{self.ft(v)}   (max {self.ft(mx, 0)})")

    def update_sensors(self, snap):
        self.set_temp_row("cpu_temp", snap["cpu_temp"])
        for path, v in snap["cores"].items():
            self.set_temp_row("core:" + path, v)
        for name, w in snap["watts"].items():
            lbl = self.sv.get("w:" + name)
            if lbl is not None:
                lbl.set_text(f"{w:.1f} W")
        meter = self.hub.meter
        if not meter.domains:
            self.lbl_power_note.set_text("This CPU/kernel exposes no RAPL power counters, so CPU watts cannot be measured.")
        elif meter.source == "none":
            self.lbl_power_note.set_text(
                "Power counters are root-only on this kernel. Enable the sampler once:  "
                "sudo systemctl enable --now cputhrottle-sampler")
        elif meter.source == "sampler":
            self.lbl_power_note.set_text("Power is read from the cputhrottle-sampler service.")
        else:
            self.lbl_power_note.set_text("")
        for path, v in snap["other"].items():
            self.set_temp_row("o:" + path, v)
        for path, v in snap["fans"].items():
            lbl = self.sv.get("f:" + path)
            if lbl is not None:
                lbl.set_text(f"{v} RPM" if v is not None else "—")
        if "batt_w" in self.sv:
            bw = snap["batt_w"]
            state = {"Charging": "charging", "Discharging": "discharging", "Full": "full"}.get(battery_info()[1], "")
            self.sv["batt_w"].set_text(f"{bw:.1f} W" + (f"  ({state})" if state else "") if bw is not None else "—")

        for i, d in enumerate(snap["gpus"]):
            if i >= len(self.gpu_frames):
                self.add_gpu_frame(i, d)
            self.set_temp_row(f"g{i}:temp", d.get("temp"))
            for label, v in d["temps"][1:]:
                self.set_temp_row(f"g{i}:t:{label}", v)
            lbl = self.sv.get(f"g{i}:power")
            if lbl is not None:
                p, cap = d.get("power"), d.get("cap")
                lbl.set_text("—" if p is None else f"{p:.1f} W" + (f"  / limit {cap:.0f} W" if cap else ""))
            for key, fmt in (("util", "{:.0f} %"), ("clock", "{:.0f} MHz")):
                lbl = self.sv.get(f"g{i}:{key}")
                if lbl is not None:
                    lbl.set_text(fmt.format(d[key]) if d.get(key) is not None else "—")
            lbl = self.sv.get(f"g{i}:fan")
            if lbl is not None:
                lbl.set_text(f"{d['fan']:.0f} {d.get('fan_unit', 'RPM')}" if d.get("fan") is not None else "—")

        pkg = self.pkg_watts(snap)
        self.spark["cpu_w"].push(pkg)
        self.spark["cpu_t"].push(to_unit(snap["cpu_temp"], self.unit) if snap["cpu_temp"] is not None else None)
        g0 = snap["gpus"][0] if snap["gpus"] else {}
        self.spark["gpu_w"].push(g0.get("power"))
        self.spark["gpu_t"].push(to_unit(g0["temp"], self.unit) if g0.get("temp") is not None else None)
        for k in ("cpu_t", "gpu_t"):
            self.spark[k].unit = "°" + self.unit

    @staticmethod
    def pkg_watts(snap):
        w = snap["watts"]
        if "package-0" in w:
            return w["package-0"]
        return next(iter(w.values()), None)

