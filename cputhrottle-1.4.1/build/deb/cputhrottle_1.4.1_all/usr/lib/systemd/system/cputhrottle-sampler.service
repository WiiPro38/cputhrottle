[Unit]
Description=CPU Throttle power sampler (publishes live CPU watts to /run/cputhrottle)
ConditionPathExists=/sys/class/powercap

[Service]
Type=simple
ExecStart=/usr/libexec/cputhrottle-helper sample
RuntimeDirectory=cputhrottle
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5
Nice=10
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
